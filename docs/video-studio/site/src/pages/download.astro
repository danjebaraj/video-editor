---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { withBase } from "@cloudflare/nimbus-docs/runtime";
import "@/styles/landing.css";

export const prerender = true;
const href = (p: string) => withBase(p, import.meta.env.BASE_URL);
const fileHref = "/releases/latest/mac";
---

<BaseLayout
  title="Download Syncfusion Video Studio for Mac"
  description="Download Syncfusion Video Studio for macOS (Apple silicon, macOS 26 or later), then install it and set it up in a few minutes."
>
  <div class="flex flex-col min-h-screen">
    <Header showSidebar={false} />
    <main id="main-content" tabindex="-1" class="flex-1">
      <section class="vs-hero">
        <div class="mx-auto max-w-3xl px-4 sm:px-6 pt-16 pb-10 text-center">
          <img src={href("/app-icon.png")} alt="" width="88" height="88" class="mx-auto h-22 w-22 drop-shadow-xl" />

          {/* Before the click */}
          <div data-state="ready">
            <h1 class="mt-6 text-4xl font-bold tracking-tight text-foreground">Download Video Studio</h1>
            <p class="mt-3 text-lg text-muted-foreground">For Mac with Apple silicon, macOS 26 or later.</p>
            <a href={fileHref} class="vs-btn-download mt-8 px-7 py-3.5 text-base" data-start-download>
              <Icon name="ph:apple-logo-fill" class="w-5 h-5" />
              Download for Mac
            </a>
            <p class="mt-4 text-sm text-muted-foreground">
              <span data-release-line>Version <span data-release="version">–</span> · <span data-release="size">–</span> · disk image (.dmg)</span>
            </p>
          </div>

          {/* After the click */}
          <div data-state="started" hidden>
            <h1 class="mt-6 text-4xl font-bold tracking-tight text-foreground">Thanks for downloading</h1>
            <p class="mt-3 text-lg text-muted-foreground">
              Your download should start in a moment. If it doesn't, <a href={fileHref} class="font-medium text-foreground">download it directly</a>.
            </p>
            <p class="mt-2 text-sm text-muted-foreground">Then follow the steps below to install it.</p>
          </div>

          <div data-release-if="missing" hidden class="mt-8 rounded-xl border border-border bg-card p-5 text-sm text-muted-foreground">
            The download isn't available right now. Please try again in a few minutes.
          </div>
        </div>
      </section>

      <section class="border-t border-border">
        <div class="mx-auto max-w-3xl px-4 sm:px-6 py-14">
          <h2 class="text-2xl font-bold tracking-tight text-foreground">Install it</h2>
          <ol class="mt-8 grid gap-5 list-none p-0">
            <li class="flex gap-4 rounded-xl border border-border bg-card p-5">
              <span class="vs-step-num shrink-0">1</span>
              <div>
                <h3 class="text-base font-semibold text-foreground">Open the disk image</h3>
                <p class="mt-1 text-sm text-muted-foreground leading-relaxed">Double-click <code>Syncfusion-Video-Studio-….dmg</code> in your Downloads folder.</p>
              </div>
            </li>
            <li class="flex gap-4 rounded-xl border border-border bg-card p-5">
              <span class="vs-step-num shrink-0">2</span>
              <div>
                <h3 class="text-base font-semibold text-foreground">Drag the app to Applications</h3>
                <p class="mt-1 text-sm text-muted-foreground leading-relaxed">Drag <strong>Syncfusion Video Studio</strong> onto the <strong>Applications</strong> folder in the same window, then eject the disk image.</p>
              </div>
            </li>
            <li class="flex gap-4 rounded-xl border border-border bg-card p-5">
              <span class="vs-step-num shrink-0">3</span>
              <div>
                <h3 class="text-base font-semibold text-foreground">Open it</h3>
                <p class="mt-1 text-sm text-muted-foreground leading-relaxed">Open Video Studio from Applications or Launchpad.</p>
                <div data-release-if="unnotarized" class="mt-3 rounded-lg border border-[color-mix(in_oklch,var(--vs-orange)_35%,transparent)] bg-[color-mix(in_oklch,var(--vs-orange)_8%,transparent)] p-4 text-sm leading-relaxed text-foreground">
                  <p class="font-semibold flex items-center gap-2"><Icon name="ph:shield-warning" class="w-4 h-4 text-[var(--vs-orange)]" />The first time, macOS asks you to confirm</p>
                  <p class="mt-1 text-muted-foreground">This build isn't notarized by Apple yet, so macOS says it can't verify the app. To open it once:</p>
                  <ol class="mt-2 ms-5 list-decimal text-muted-foreground space-y-1">
                    <li>Click <strong>Done</strong> in the message.</li>
                    <li>Open <strong>System Settings › Privacy &amp; Security</strong> and scroll to <strong>Security</strong>.</li>
                    <li>Next to “Syncfusion Video Studio was blocked”, click <strong>Open Anyway</strong>, then confirm with your password or Touch ID.</li>
                  </ol>
                  <p class="mt-2 text-muted-foreground">After that it opens normally.</p>
                </div>
              </div>
            </li>
            <li class="flex gap-4 rounded-xl border border-border bg-card p-5">
              <span class="vs-step-num shrink-0">4</span>
              <div>
                <h3 class="text-base font-semibold text-foreground">Finish the setup checklist</h3>
                <p class="mt-1 text-sm text-muted-foreground leading-relaxed">The Welcome window lists what Video Studio needs, with a fix for each:</p>
                <ul class="mt-2 ms-5 list-disc text-sm text-muted-foreground space-y-1">
                  <li><strong>Claude Code</strong> 2.1.0 or later: install it, then run <code>claude</code> in Terminal once and sign in.</li>
                  <li><strong>cutline</strong>: install it, then click <strong>Install Dependencies</strong> (a few minutes).</li>
                  <li><strong>ElevenLabs key</strong> (optional): for generated voice-over and music, in Settings › ElevenLabs.</li>
                </ul>
                <a href={href("/getting-started/before-you-start/")} class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-foreground no-underline hover:text-[var(--vs-orange)]">Setup in detail <Icon name="ph:arrow-right" class="w-3.5 h-3.5" /></a>
              </div>
            </li>
          </ol>

          <div class="mt-10 grid gap-4 sm:grid-cols-2">
            <a href={href("/getting-started/quick-start/")} class="rounded-xl border border-border bg-card p-5 no-underline hover:border-border-strong transition-colors">
              <p class="text-sm font-semibold text-foreground flex items-center gap-2"><Icon name="ph:rocket-launch" class="w-4 h-4 text-[var(--vs-orange)]" />Make your first video</p>
              <p class="mt-1 text-sm text-muted-foreground">A hands-on walkthrough, from a new project to finished videos.</p>
            </a>
            <a href={href("/reference/troubleshooting/")} class="rounded-xl border border-border bg-card p-5 no-underline hover:border-border-strong transition-colors">
              <p class="text-sm font-semibold text-foreground flex items-center gap-2"><Icon name="ph:lifebuoy" class="w-4 h-4 text-[var(--vs-orange)]" />Troubleshooting</p>
              <p class="mt-1 text-sm text-muted-foreground">Sign-in, missing tools, permissions and more.</p>
            </a>
          </div>

          <details class="mt-10 rounded-xl border border-border bg-card p-5 text-sm">
            <summary class="cursor-pointer font-semibold text-foreground">Release details</summary>
            <dl class="mt-4 grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-muted-foreground">
              <dt>Version</dt><dd class="text-foreground" data-release="version">–</dd>
              <dt>Published</dt><dd class="text-foreground" data-release="date">–</dd>
              <dt>Size</dt><dd class="text-foreground" data-release="size">–</dd>
              <dt>Requires</dt><dd class="text-foreground"><span data-release="macos">macOS 26 or later</span>, Apple silicon</dd>
              <dt>SHA-256</dt><dd class="text-foreground font-mono text-xs break-all" data-release="sha256">–</dd>
            </dl>
            <p class="mt-4 text-muted-foreground">To check the file, run <code>shasum -a 256 ~/Downloads/Syncfusion-Video-Studio-*.dmg</code> in Terminal and compare.</p>
          </details>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { fillRelease } from "@/components/landing/release.client";
  fillRelease();

  // Start the download, then swap the heading for the install steps. Visiting
  // /download/?start (or #start) starts it right away.
  const show = (state: "ready" | "started") =>
    document.querySelectorAll<HTMLElement>("[data-state]").forEach((el) => (el.hidden = el.dataset.state !== state));
  const start = () => {
    show("started");
    const frame = document.createElement("iframe");
    frame.hidden = true;
    frame.src = "/releases/latest/mac";
    document.body.append(frame);
  };
  // The big button, and the header's Download button while on this page.
  document.querySelectorAll<HTMLAnchorElement>("[data-start-download], [data-download-button]").forEach((a) =>
    a.addEventListener("click", (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: "smooth" });
      start();
    }),
  );
  const params = new URLSearchParams(location.search);
  if (params.has("start") || location.hash === "#start") start();
</script>
