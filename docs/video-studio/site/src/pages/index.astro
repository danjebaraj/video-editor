---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { withBase } from "@cloudflare/nimbus-docs/runtime";
import "@/styles/landing.css";

export const prerender = true;
const base = import.meta.env.BASE_URL;
const href = (p: string) => withBase(p, base);

const steps = [
  { title: "Describe it", text: "Write the video as a Markdown spec: scenes, voice-over, shots, music and a call to action.", link: "/write/spec/" },
  { title: "Refine it with Claude", text: "Claude tightens the script, fills gaps and asks what it needs to know. You accept or reject every change.", link: "/write/claude/" },
  { title: "Pick a brand and platforms", text: "Choose a brand preset and the outputs you want: YouTube, Shorts, LinkedIn, Reels and more.", link: "/configure/outputs/" },
  { title: "Run it", text: "Validate for free, check the plan with a cheap dry run, then let Claude Code and cutline produce every cut.", link: "/run/running/" },
];

const features = [
  { icon: "ph:note-pencil", title: "A spec editor made for video", text: "Scene, voice-over, shot, music and call-to-action blocks one / away, with live checks that every line of narration fits its scene." },
  { icon: "ph:sparkle", title: "Claude as your co-writer", text: "Ask for changes in plain words. Every edit comes back as a reviewable change, and Claude interviews you about anything missing." },
  { icon: "ph:palette", title: "Brands that stay on brand", text: "Logos, colours, fonts, voice, music mood and rules in one preset, plus instruction sets for each product line." },
  { icon: "ph:devices", title: "Every platform in one run", text: "Built-in presets know each platform's shape, caption style and limits, so one spec becomes a landscape cut, a Short and a square post." },
  { icon: "ph:waveform", title: "Natural voice-over and music", text: "ElevenLabs or Cartesia narration that sounds like one continuous read, with delivery tags, generated music and burned-in captions." },
  { icon: "ph:record", title: "It records your app for you", text: "Write the steps; the run opens the app, clicks through them and records the window for the edit. No screen recording by hand." },
  { icon: "ph:shield-check", title: "No surprises on cost", text: "Validation and a cheap dry run catch problems first. Every run shows its estimate, and spend and credit limits are enforced." },
  { icon: "ph:magnifying-glass", title: "Every run, fully traceable", text: "Each run keeps its spec, prompts, decisions, QA checks and logs. Revise a finished run with feedback and it picks up where it left off." },
];

const specSample = "<span class=\"h\">## Scene 2: Build a flowchart</span>\n\n- <span class=\"k\">**Duration:**</span> 12 s\n- <span class=\"k\">**Media:**</span> ![Editor demo](<span class=\"m\">media:m-diagram-demo</span>)\n- <span class=\"k\">**On-screen text:**</span> Drag, drop, connect\n\n<span class=\"f\">```vo</span>\n[warmly] Drag shapes from the palette,\ndrop them on the canvas, and connect\nthem in seconds.\n<span class=\"f\">```</span>\n\n<span class=\"h\">## Scene 3: Export</span>\n\n- <span class=\"k\">**Duration:**</span> 10 s\n- <span class=\"k\">**Record:**</span> Diagram Builder\n  1. Click Export › PNG";

const shots = [
  { src: "/guide/claude-review.png", title: "Review every change Claude makes", text: "Claude edits the spec, and each change comes back as before and after. You accept or reject it.", alt: "Claude's changes to the spec shown as before and after, each with Accept and Reject buttons" },
  { src: "/guide/validation.png", title: "Catch problems before you spend", text: "Validation checks the spec, media, brand and outputs for free, and shows the estimated cost.", alt: "The Validation tab with a blocker, warnings and a cost estimate" },
  { src: "/guide/run-results.png", title: "Every video, with a quality check", text: "Each output is checked against its platform's rules, and you can revise a finished run with feedback.", alt: "A finished run with the YouTube Shorts video and its QA pass" },
];

const platforms = ["YouTube 1080p", "YouTube 4K", "YouTube Shorts", "TikTok", "Instagram Reels", "Instagram Feed", "LinkedIn", "X / Twitter", "Facebook", "App Store preview", "Google Play promo", "Website hero loop"];
---

<BaseLayout
  title="Syncfusion Video Studio: from a written brief to finished videos"
  description="Describe a video in Markdown, refine it with Claude, attach media by reference, then let Claude Code and cutline produce every platform cut. For macOS."
>
  <div class="flex flex-col min-h-screen">
    <Header showSidebar={false} />
    <main id="main-content" tabindex="-1" class="flex-1">
      {/* Hero */}
      <section class="vs-hero">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 sm:pt-24 pb-12 text-center">
          <img src={href("/app-icon.png")} alt="" width="96" height="96" class="mx-auto h-24 w-24 drop-shadow-xl" />
          <p class="mt-6 text-sm font-semibold tracking-wide text-[var(--vs-orange)] uppercase">Syncfusion Video Studio</p>
          <h1 class="mx-auto mt-3 max-w-3xl text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-foreground leading-[1.08] [text-wrap:balance]">
            From a written brief to finished videos
          </h1>
          <p class="mx-auto mt-5 max-w-2xl text-lg text-muted-foreground leading-relaxed [text-wrap:pretty]">
            Describe the video in Markdown, refine it with Claude, and let Claude Code and cutline produce every platform cut: voice-over, music, captions, app recordings and all.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href={href("/download/")} class="vs-btn-download px-6 py-3 text-base">
              <Icon name="ph:apple-logo-fill" class="w-5 h-5" />
              Download for Mac
            </a>
            <a href={href("/introduction/")} class="inline-flex items-center gap-2 rounded-[0.625rem] px-6 py-3 text-base font-semibold text-foreground no-underline ring ring-border bg-card hover:bg-accent transition-colors">
              <Icon name="ph:book-open" class="w-5 h-5" />
              Read the guide
            </a>
          </div>
          <p class="mt-4 text-sm text-muted-foreground">
            Apple silicon · macOS 26 or later
            <span data-release-line hidden> · Version <span data-release="version"></span> · <span data-release="size"></span></span>
          </p>

          {/* The app */}
          <a href={href("/guide/project-window.png")} class="mx-auto mt-14 block max-w-5xl">
            <img src={href("/guide/project-window.png")} alt="The Syncfusion Video Studio window: the outline of a video's scenes, the Markdown spec in the middle, and Claude on the right" width="1600" height="1042" class="w-full h-auto" fetchpriority="high" />
          </a>
        </div>
      </section>

      {/* How it works */}
      <section class="border-t border-border">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 py-20">
          <h2 class="text-3xl font-bold tracking-tight text-foreground text-center">How it works</h2>
          <p class="mt-3 text-center text-muted-foreground max-w-2xl mx-auto">You decide what the video says. Video Studio takes care of turning it into finished files.</p>
          <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4 list-none p-0">
            {steps.map((s, i) => (
              <li class="rounded-xl border border-border bg-card p-6">
                <span class="vs-step-num">{i + 1}</span>
                <h3 class="mt-4 text-base font-semibold text-foreground">{s.title}</h3>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{s.text}</p>
                <a href={href(s.link)} class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-foreground no-underline hover:text-[var(--vs-orange)]">Learn more <Icon name="ph:arrow-right" class="w-3.5 h-3.5" /></a>
              </li>
            ))}
          </ol>
        </div>
      </section>

      {/* A closer look */}
      <section class="border-t border-border">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 py-20">
          <h2 class="text-3xl font-bold tracking-tight text-foreground text-center">A closer look</h2>
          <p class="mt-3 text-center text-muted-foreground max-w-2xl mx-auto">Real screenshots from a project, from the first edit to the finished video.</p>
          <div class="mt-12 grid gap-8 lg:grid-cols-3">
            {shots.map((s) => (
              <figure class="m-0">
                <a href={href(s.src)} class="block overflow-hidden rounded-xl border border-border bg-muted">
                  <img src={href(s.src)} alt={s.alt} loading="lazy" width="1600" height="1042" class="w-full h-auto" />
                </a>
                <figcaption class="mt-4">
                  <h3 class="text-base font-semibold text-foreground">{s.title}</h3>
                  <p class="mt-1 text-sm text-muted-foreground leading-relaxed">{s.text}</p>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      {/* Features */}
      <section class="border-t border-border bg-muted">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 py-20">
          <h2 class="text-3xl font-bold tracking-tight text-foreground text-center">Everything a product video needs</h2>
          <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {features.map((f) => (
              <div class="rounded-xl border border-border bg-card p-6">
                <div class="vs-feature-icon"><Icon name={f.icon} class="w-5 h-5" /></div>
                <h3 class="mt-4 text-base font-semibold text-foreground">{f.title}</h3>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{f.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Platforms */}
      <section class="border-t border-border">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 py-20 text-center">
          <h2 class="text-3xl font-bold tracking-tight text-foreground">One spec, every platform</h2>
          <p class="mt-3 text-muted-foreground max-w-2xl mx-auto">Each preset knows its platform's shapes, caption style, length and size limits, and validation checks your video against them before a run.</p>
          <div class="mt-8 flex flex-wrap justify-center gap-2">
            {platforms.map((p) => <span class="vs-chip">{p}</span>)}
          </div>
          <a href={href("/configure/outputs/")} class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-foreground no-underline hover:text-[var(--vs-orange)]">See every preset and its limits <Icon name="ph:arrow-right" class="w-3.5 h-3.5" /></a>
        </div>
      </section>

      {/* Requirements and closing call to action */}
      <section class="vs-cta-band">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 grid gap-10 lg:grid-cols-2 items-center">
          <div>
            <h2 class="text-3xl font-bold tracking-tight">Make your next video from a brief</h2>
            <p class="mt-3 text-white/75 leading-relaxed">Download the app, sign in to Claude Code, install cutline, and your first project is a few minutes away.</p>
            <div class="mt-6 flex flex-col sm:flex-row gap-3">
              <a href={href("/download/")} class="vs-btn-download px-6 py-3 text-base justify-center"><Icon name="ph:apple-logo-fill" class="w-5 h-5" />Download for Mac</a>
              <a href={href("/getting-started/before-you-start/")} class="inline-flex items-center justify-center gap-2 rounded-[0.625rem] px-6 py-3 text-base font-semibold text-white no-underline ring ring-white/30 hover:bg-white/10 transition-colors">Setup guide</a>
            </div>
          </div>
          <ul class="grid gap-3 list-none p-0 m-0 text-sm">
            <li class="flex gap-3 items-start"><Icon name="ph:laptop" class="w-5 h-5 shrink-0 text-[var(--vs-orange)]" /><span><strong>A Mac with Apple silicon</strong> running macOS 26 or later.</span></li>
            <li class="flex gap-3 items-start"><Icon name="ph:terminal-window" class="w-5 h-5 shrink-0 text-[var(--vs-orange)]" /><span><strong>Claude Code</strong> 2.1.0 or later, signed in. The app never asks for your Anthropic credentials.</span></li>
            <li class="flex gap-3 items-start"><Icon name="ph:film-strip" class="w-5 h-5 shrink-0 text-[var(--vs-orange)]" /><span><strong>cutline</strong> and its tools, which the app can install for you.</span></li>
            <li class="flex gap-3 items-start"><Icon name="ph:microphone" class="w-5 h-5 shrink-0 text-[var(--vs-orange)]" /><span><strong>An ElevenLabs key</strong> (optional) for generated voice-over and music.</span></li>
          </ul>
        </div>
      </section>
    </main>

    <footer class="border-t border-border">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-8 flex flex-col sm:flex-row gap-4 items-center justify-between text-sm text-muted-foreground">
        <div class="flex items-center gap-2"><img src={href("/app-icon-64.png")} alt="" width="20" height="20" />© Syncfusion, Inc.</div>
        <nav class="flex gap-5" aria-label="Footer">
          <a class="no-underline text-muted-foreground hover:text-foreground" href={href("/introduction/")}>Docs</a>
          <a class="no-underline text-muted-foreground hover:text-foreground" href={href("/download/")}>Download</a>
          <a class="no-underline text-muted-foreground hover:text-foreground" href={href("/reference/troubleshooting/")}>Troubleshooting</a>
        </nav>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  import { fillRelease } from "@/components/landing/release.client";
  fillRelease().then((r) => {
    if (r) document.querySelectorAll<HTMLElement>("[data-release-line]").forEach((el) => (el.hidden = false));
  });
</script>
