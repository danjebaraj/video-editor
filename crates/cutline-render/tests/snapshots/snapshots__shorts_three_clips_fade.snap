[dialogue]highpass=f=80:poles=2,afftdn=nr=10:nf=-50:tn=1,deesser=i=0.4:m=0.5:f=0.5:s=o,equalizer=f=4000:t=q:w=1.0:g=2,equalizer=f=320:t=q:w=1.2:g=-2,acompressor=threshold=-20dB:ratio=3:attack=10:release=150:makeup=2,alimiter=limit=0.89:attack=5:release=50:level=disabled,atrim=end_sample=216000,aformat=sample_fmts=flt:channel_layouts=stereo[stem_dialogue]

