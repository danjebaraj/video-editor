[0:a]anull[mix]

# loudness pass 1 (measure)
ffmpeg -hide_banner -nostdin -nostats -i <work>/mix.wav -af loudnorm=I=-14:TP=-1:LRA=7:print_format=json -f null -

# loudness pass 2 (apply; values from pass 1)
ffmpeg -hide_banner -nostdin -y -i <work>/mix.wav -af 'loudnorm=I=-14:TP=-1:LRA=7:measured_I=<I>:measured_TP=<TP>:measured_LRA=<LRA>:measured_thresh=<thresh>:offset=<offset>:linear=true:print_format=json,aresample=48000' -c:a pcm_f32le <work>/final_audio.wav

# final encode
