{
  "$defs": {
    "AppCapture": {
      "description": "App recording: during a production run Claude Code can open a desktop app or a web app,\noperate it and record the screen, to make footage the spec asks for.",
      "properties": {
        "apps": {
          "default": [],
          "description": "When not empty, the only apps a run may drive (names as shown in Applications). Empty\nmeans any app except terminals, system settings, password managers and Finder.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "AssetRef": {
      "description": "A referenced brand file (logo, font, bumper). Never copied, except into a `.cutbrand` export.",
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fingerprint"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "AssistantSessionRef": {
      "additionalProperties": true,
      "properties": {
        "claude_session": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "BrandPreset": {
      "properties": {
        "caption_style": {
          "default": "",
          "type": "string"
        },
        "colors": {
          "$ref": "#/$defs/Palette",
          "default": {
            "accent": "#2D9CDB",
            "background": "#FFFFFF",
            "primary": "#F26B21",
            "secondary": "#1F2A44",
            "text": "#111827"
          }
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "fonts": {
          "$ref": "#/$defs/Fonts",
          "default": {
            "body": {},
            "heading": {}
          }
        },
        "id": {
          "type": "string"
        },
        "instructions": {
          "description": "Labelled instructions a project chooses from (see [`BrandRef::instructions`]).",
          "items": {
            "$ref": "#/$defs/InstructionSet"
          },
          "type": "array"
        },
        "intro": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "logos": {
          "$ref": "#/$defs/Logos",
          "default": {}
        },
        "lower_third_style": {
          "default": "",
          "type": "string"
        },
        "modified": {
          "default": "",
          "type": "string"
        },
        "music_mood": {
          "default": "",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "outro": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "rules": {
          "default": "",
          "description": "Do's and don'ts in free text, given to Claude verbatim in every project.",
          "type": "string"
        },
        "voice": {
          "$ref": "#/$defs/Voice",
          "default": {
            "voice_id": ""
          }
        },
        "watermark": {
          "$ref": "#/$defs/Watermark",
          "default": {
            "opacity": 0.6,
            "position": "bottom_right"
          }
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "BrandRef": {
      "description": "The preset a project uses: its library ID and a full copy taken when it was chosen.",
      "properties": {
        "instructions": {
          "description": "IDs of the snapshot's instruction sets this project uses. None are chosen at first.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "preset_id": {
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/BrandPreset"
        }
      },
      "required": [
        "preset_id",
        "snapshot"
      ],
      "type": "object"
    },
    "Energy": {
      "description": "How much drive the voice and the music have.",
      "oneOf": [
        {
          "const": "calm",
          "description": "Unhurried voice, soft slow music: explainers, serious subjects.",
          "type": "string"
        },
        {
          "const": "balanced",
          "description": "A natural read over light music with a steady beat.",
          "type": "string"
        },
        {
          "const": "upbeat",
          "description": "A bright, lively read over driving music, with short pauses.",
          "type": "string"
        }
      ]
    },
    "Fingerprint": {
      "properties": {
        "mtime": {
          "type": "string"
        },
        "quick_hash": {
          "description": "SHA-256 of the first, middle and last 1 MiB plus the size.",
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "size",
        "mtime",
        "quick_hash"
      ],
      "type": "object"
    },
    "Finish": {
      "properties": {
        "cut_on_beat": {
          "default": true,
          "description": "Land cuts on the music's beat and ask for music with a beat that can be followed.",
          "type": "boolean"
        },
        "ease_text": {
          "default": true,
          "description": "Ease on-screen text in and out instead of popping it on.",
          "type": "boolean"
        },
        "energy": {
          "$ref": "#/$defs/Energy",
          "default": "upbeat",
          "description": "How lively the voice and the music are."
        },
        "guide_the_eye": {
          "default": true,
          "description": "Ease into close-ups of the part of the screen being talked about.",
          "type": "boolean"
        },
        "lead_in_s": {
          "default": 1.2,
          "description": "Seconds of picture and music before the first spoken word.",
          "format": "double",
          "type": "number"
        },
        "music_fade_in_s": {
          "default": 1.0,
          "description": "Seconds the music takes to come in.",
          "format": "double",
          "type": "number"
        },
        "music_fade_out_s": {
          "default": 2.0,
          "description": "Seconds the music takes to go out when it has no ending of its own to land.",
          "format": "double",
          "type": "number"
        },
        "tail_s": {
          "default": 2.0,
          "description": "Seconds the last picture holds after the last spoken word.",
          "format": "double",
          "type": "number"
        },
        "transition_s": {
          "default": 0.4,
          "description": "Length of a transition between scenes, in seconds.",
          "format": "double",
          "type": "number"
        },
        "transitions": {
          "$ref": "#/$defs/Transitions",
          "default": "smooth"
        }
      },
      "type": "object"
    },
    "FontRef": {
      "description": "A font by installed family name or by file.",
      "properties": {
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Fonts": {
      "properties": {
        "body": {
          "$ref": "#/$defs/FontRef",
          "default": {}
        },
        "heading": {
          "$ref": "#/$defs/FontRef",
          "default": {}
        }
      },
      "type": "object"
    },
    "InstructionSet": {
      "description": "A labelled set of instructions for Claude, such as the context of one product line\n(\"Bold Reports\", \"Syncfusion WPF\"). A brand holds any number; each project picks the ones\nthat apply, so every video of that product gets the same context and voice.",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "text": {
          "default": "",
          "description": "Free text, given to Claude verbatim.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "Intent": {
      "properties": {
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "cta": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/IntentKind",
          "default": "unset"
        },
        "locales": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "other": {
          "description": "Free text when `kind` is `other`.",
          "type": [
            "string",
            "null"
          ]
        },
        "target_length_s": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "tone": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "IntentKind": {
      "oneOf": [
        {
          "enum": [
            "marketing",
            "product_demo",
            "tutorial",
            "explainer",
            "social_clip",
            "testimonial",
            "announcement",
            "event_recap",
            "internal",
            "app_store_preview",
            "other"
          ],
          "type": "string"
        },
        {
          "const": "unset",
          "description": "Not chosen yet. Validation reports this as a blocker.",
          "type": "string"
        }
      ]
    },
    "Logos": {
      "properties": {
        "dark": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "For dark backgrounds."
        },
        "horizontal": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "light": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "For light backgrounds."
        },
        "primary": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "MediaItem": {
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fingerprint"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "description": "Stable, short and human-readable, for example `m-intro-take2`.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "pasted": {
          "description": "A pasted clipboard image stored in the `.assets` sidecar (the one case the app writes media).",
          "type": "boolean"
        },
        "paths": {
          "$ref": "#/$defs/MediaPaths",
          "default": {}
        },
        "probe": {
          "anyOf": [
            {
              "$ref": "#/$defs/Probe"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaRole"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "MediaKind": {
      "enum": [
        "video",
        "audio",
        "image",
        "font",
        "transcript",
        "tape",
        "demo_script",
        "other"
      ],
      "type": "string"
    },
    "MediaPaths": {
      "properties": {
        "absolute": {
          "type": [
            "string",
            "null"
          ]
        },
        "bookmark_macos": {
          "description": "Security-scoped bookmark (base64), when the macOS shell could make one.",
          "type": [
            "string",
            "null"
          ]
        },
        "file_id_windows": {
          "description": "`<volume serial>:<128-bit file ID>` (hex), when made on Windows. Each platform uses its own\nentry, ignores the other's and keeps it when saving (ui/spec.md §6.2).",
          "type": [
            "string",
            "null"
          ]
        },
        "relative": {
          "description": "Relative to the project file's folder, with forward slashes.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MediaRole": {
      "description": "A hint for Claude about how a file is meant to be used.",
      "enum": [
        "footage",
        "b_roll",
        "screen_recording",
        "logo",
        "music",
        "sfx",
        "voice",
        "reference"
      ],
      "type": "string"
    },
    "Models": {
      "properties": {
        "assistant": {
          "description": "Spec assistant model: a CLI alias (`sonnet`) or a full model ID. Empty follows the\ndefault in Settings.",
          "type": "string"
        },
        "dry_run": {
          "description": "Dry run model. Empty follows the default in Settings.",
          "type": "string"
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "web_access": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "assistant",
        "dry_run"
      ],
      "type": "object"
    },
    "OutputConfig": {
      "description": "A named delivery target in a project: a preset plus overrides.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "overrides": {
          "$ref": "#/$defs/OutputOverrides",
          "default": {}
        },
        "preset": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "preset"
      ],
      "type": "object"
    },
    "OutputOverrides": {
      "description": "Per-project changes on top of a preset.",
      "properties": {
        "audio": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "captions": {
          "type": [
            "string",
            "null"
          ]
        },
        "formats": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "fps": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "loop": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "max_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_duration_s": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Palette": {
      "properties": {
        "accent": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "primary",
        "secondary",
        "accent",
        "background",
        "text"
      ],
      "type": "object"
    },
    "Probe": {
      "properties": {
        "audio_channels": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "audio_codec": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_s": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "error": {
          "description": "Why probing failed, when it did.",
          "type": [
            "string",
            "null"
          ]
        },
        "for_hash": {
          "description": "The fingerprint hash this probe was made for; a different file is probed again.",
          "type": [
            "string",
            "null"
          ]
        },
        "fps": {
          "description": "Frame rate as `num/den`.",
          "type": [
            "string",
            "null"
          ]
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "loudness_lufs": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "rotation": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "vfr": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "video_codec": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Quality": {
      "enum": [
        "draft",
        "final"
      ],
      "type": "string"
    },
    "RunConfig": {
      "properties": {
        "dry_run_first": {
          "default": true,
          "type": "boolean"
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "eleven_credit_cap": {
          "default": 20000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "locales": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_spend_usd": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "max_turns": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "output_folder": {
          "default": "",
          "description": "Parent folder for this config's run folders; `~` is expanded. Empty means the default.",
          "type": "string"
        },
        "outputs": {
          "default": [],
          "description": "IDs of the selected output configs.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "production_model": {
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/Quality",
          "default": "final"
        },
        "question_timeout_s": {
          "description": "Seconds a question may wait before Claude proceeds on its stated assumption.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "web_access": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "production_model"
      ],
      "type": "object"
    },
    "RunKind": {
      "enum": [
        "dry_run",
        "production"
      ],
      "type": "string"
    },
    "RunRecord": {
      "properties": {
        "claude_session": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost_usd": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "eleven_credits": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "finished": {
          "type": [
            "string",
            "null"
          ]
        },
        "folder": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RunKind"
        },
        "model": {
          "description": "Model ID actually used.",
          "type": [
            "string",
            "null"
          ]
        },
        "previous_run": {
          "description": "The run this one revises.",
          "type": [
            "string",
            "null"
          ]
        },
        "run_config": {
          "type": "string"
        },
        "run_config_name": {
          "description": "The run config's name when the run started (configs can be renamed or deleted later).",
          "type": [
            "string",
            "null"
          ]
        },
        "started": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        }
      },
      "required": [
        "id",
        "run_config",
        "kind",
        "folder",
        "status",
        "started"
      ],
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "running",
        "succeeded",
        "succeeded_with_warnings",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "Transitions": {
      "description": "How one shot hands over to the next.",
      "oneOf": [
        {
          "const": "smooth",
          "description": "A short soft move between scenes, plain cuts inside a scene.",
          "type": "string"
        },
        {
          "const": "cuts",
          "description": "Plain cuts everywhere; fades only for the title and the end card.",
          "type": "string"
        },
        {
          "const": "lively",
          "description": "Quick moving transitions (whips, pushes) between scenes, for social cuts.",
          "type": "string"
        }
      ]
    },
    "Voice": {
      "properties": {
        "cartesia_voice_id": {
          "description": "Cartesia voice ID, used when Settings › Voice has Cartesia speak the voice-over.",
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "settings": {
          "additionalProperties": true,
          "description": "ElevenLabs voice settings (stability, similarity_boost, style, speed).",
          "type": [
            "object",
            "null"
          ]
        },
        "voice_id": {
          "default": "",
          "description": "ElevenLabs voice ID.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Watermark": {
      "properties": {
