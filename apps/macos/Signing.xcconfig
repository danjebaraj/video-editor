// Code signing for Syncfusion Video Studio.
//
// The default is an ad-hoc signature, which needs no certificate. macOS ties Screen Recording and
// Accessibility permissions to the signature, and an ad-hoc signature changes with every build, so
// those permissions must be allowed again after each one.
//
// To keep permissions across builds, sign with a certificate of your own: run `./build.sh signing`, or copy
// Signing.local.xcconfig.example to Signing.local.xcconfig and fill it in. That file is not in
// source control, so each machine can use its own certificate.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
