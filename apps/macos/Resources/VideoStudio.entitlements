<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Production runs operate other apps through Apple Events (see NSAppleEventsUsageDescription).
	     Required once the hardened runtime is on, which notarized (distribute) builds use. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
